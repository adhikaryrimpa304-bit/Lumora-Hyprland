#!/usr/bin/env python3
import os, subprocess
from pathlib import Path
import gi
gi.require_version('Gtk','3.0')
from gi.repository import Gtk
folder=Path('/usr/share/backgrounds/lumora'); files=sorted(folder.glob('*'))
class Picker(Gtk.Dialog):
 def __init__(self):
  super().__init__(title='LUMORA Wallpapers',flags=0); self.add_button('Close',Gtk.ResponseType.CLOSE); self.add_button('Apply',Gtk.ResponseType.OK)
  box=self.get_content_area(); box.set_spacing(10); box.set_border_width(14)
  self.combo=Gtk.ComboBoxText(); self.files=[]
  for f in files:
   if f.suffix.lower() in ('.jpg','.jpeg','.png'):
    self.files.append(f); self.combo.append_text(f.stem.replace('lumora-','').replace('-',' ').title())
  if self.files: self.combo.set_active(0)
  box.add(Gtk.Label(label='Choose a LUMORA wallpaper')); box.add(self.combo); self.show_all()
  if self.run()==Gtk.ResponseType.OK and self.files:
   f=self.files[self.combo.get_active()]
   
   # Replace the existing wallpaper process instead of stacking another daemon.
   subprocess.run(['pkill','-x','swaybg'], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
   subprocess.Popen(['swaybg','-i',str(f),'-m','fill'],start_new_session=True)
  self.destroy()
Picker()
